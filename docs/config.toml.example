# Concerto configuration example (schema v8)
#
# Preferred setup: use the desktop setup wizard and Settings page. This file
# documents the serialized values for advanced/manual configuration.
#
# Global location: platform config directory, normally
#   ~/.config/concerto/config.toml        (Linux)
# Project override:
#   <project>/.concerto.toml
#
# API keys are not stored here. `keyring_key` names an entry in the operating-
# system credential store. Set credentials through Concerto Settings.
#
# Every section below is optional except `schema_version`. Each is documented
# with its shipped default, so a minimal config is a config with one line.

schema_version = 8

# NOTE: there is no `mode` key. The Chat/Plan/Build mode picker was removed at
# schema v6; the intent *gate* remains always-on but routes authorization, not
# topology. See docs/agent-collaboration.md.

# Per-session spend cap in USD. Omit for no cap.
session_spend_cap_usd = 5.0

# Optional project-root allowlist (ADR-44). Empty (the default) is permissive.
# A non-empty list restricts which project directories Concerto opens; on the
# api-server, out-of-root session roots are refused with HTTP 403. The
# CONCERTO_PROJECT_ROOTS environment variable (platform-separated paths)
# overrides this value.
# project_roots = ["/home/user/projects"]

# Central retry policy for transient provider errors such as 429/5xx,
# disconnects, and timeouts. It does not retry invalid configuration forever.
# These are the production defaults; shown uncommented so the shipped values
# are checkable against crates/config/src/schema.rs.
[retry]
enabled = true
initial_delay_ms = 2000
max_delay_ms = 30000
multiplier = 2.0
jitter = true
respect_retry_after = true
# fixed_delay_ms = 5000
max_attempts = 8
max_elapsed_seconds = 900            # 15-minute fuse for one outage
time_to_first_byte_seconds = 120
stream_idle_timeout_seconds = 300

# Multiple providers. Valid provider IDs are listed in docs/models.md; the
# common ones are openai, anthropic, google, openrouter, nim, ollama, opencode.
[model_settings]
global_default_id = "main-provider"

[[model_settings.providers]]
id = "main-provider"
name = "Main provider"
provider = "anthropic"
model = "your-model-id"
timeout_seconds = 60
keyring_key = "anthropic/api_key"

[[model_settings.providers]]
id = "local-provider"
name = "Local Ollama"
provider = "ollama"
model = "your-local-model-id"
api_base = "http://localhost:11434"
timeout_seconds = 120
keyring_key = "ollama/api_key"

# Optional, OpenAI-compatible providers:
#   extra_models = ["alias-model-a"]   # additional offered models (resolution only)
#   reasoning_echo = "always"          # "always" | "if-present" (ADR-46)
# See docs/models.md for details.

# Keyed by ROSTER ID, not by a fixed role vocabulary: `agent_role` is a free
# string matched against the configured roster (ADR-58). "coordinator" is
# reserved and is never registered from config.
[[model_settings.agent_assignments]]
agent_role = "coordinator"
provider_config_id = "main-provider"

[[model_settings.agent_assignments]]
agent_role = "coder"
provider_config_id = "local-provider"
# model_override = "another-tool-capable-model"

# Objective metadata overrides. These are routing hints and do not grant a
# model capabilities it does not actually have.
[model_settings.model_profile_overrides]
"local-provider" = { context_window = 32768, supports_tool_calling = true }

# Multi-agent mode is explicit; it is never turned on because a task looks
# complex. An empty relationships list uses the validated default topology
# described in docs/agent-collaboration.md.
[multi_agent]
default_enabled = false
spend_cap_multiplier = 3.0
max_concurrent_agents = 3
max_concurrent_per_provider = 2
# ADR-42 fallback ladder tier 1: retry a hard-failed subtask with the SAME
# agent on a global default model. The agent's provider is bound at startup,
# so default_model must be a model offered by that role's own provider; the
# request is NOT re-routed to another provider. default_provider_config_id
# only disambiguates which routing profile matches when the model name is
# shared across providers (it does not switch the serving provider).
# Unset/omitted keys skip this tier.
# default_model = "another-tool-capable-model"
# default_provider_config_id = "local-provider"
# ADR-45 fallback ladder tier 1b: when the role's own provider is the failure
# (latency, quota, outage), rebuild the failed role on the run's default
# provider serving the global default model. This knob gates the
# default-model fallback tier of the ladder; disable it to skip that tier.
default_model_fallback = true
# ADR-45: dispatch-attempt ceiling per subtask before the fallback ladder
# walks in. Defaults to 6 when omitted (DEFAULT_MAX_SUBTASK_ATTEMPTS).
# max_subtask_attempts = 5

# NOTE: relationship endpoints are STAGE TAGS, not agent ids. Cycle budgets
# live on the stage (`max_cycles` in [orchestration]) or come from the stage
# kind's default; `max_cycles` here is accepted but is not where the standard
# pipeline's 6/5 review/validate budgets come from.
[[multi_agent.relationships]]
from = "review"
to = "implement"
relationship = "supervises"

[[multi_agent.relationships]]
from = "validate"
to = "implement"
relationship = "supervises"

[[multi_agent.relationships]]
from = "research"
to = "implement"
relationship = "provides_context_to"

# Per-agent model override, keyed by roster id.
# [multi_agent.model_pins]
# coder = "another-model-id"

# User-defined agents. IMPORTANT: once ANY entry exists here (or an
# [orchestration] section is present), the roster is THESE ENTRIES ONLY — the
# built-in seeds are NOT merged back in, and an id deleted from config stays
# deleted. To keep a seed, redeclare it. This is ADR-58's "config owns the
# pipeline", and it is a common surprise, so it is stated here rather than
# discovered at runtime.
#
# `can_cover` is ADR-74's coverage knob: ADDITIONAL stage tags this agent can
# cover beyond its own `stage`. Effective coverage is `stage ∪ can_cover`. The
# coordinator consults it for agent-axis takeover BEFORE escalating a failed
# subtask across providers, so any agent can be made able to cover any stage
# without a code change. The desktop Studio round-trips the field but has no
# editor for it yet; config is the source of truth.
#
# [[multi_agent.custom_agents]]
# id = "coder"
# name = "Coder"
# role = "coder"
# stage = "implement"
# can_cover = ["review"]          # ADR-74: also eligible to cover review
# model_override = "another-tool-capable-model"
# provider_id = "local-provider"
# disabled = false                # true = not registered at runtime
#
# prompt_sections is a table (PromptSections), not a list of tables:
# [multi_agent.custom_agents.prompt_sections]
# system_instructions = "You are the Coder agent."
# constraints = "Never touch generated files."
# output_format = "A unified diff."
# few_shot = []
#
# `stage` is one tag from an OPEN vocabulary, not a fixed pipeline position. A
# stage-less agent is a full participant in the delegation path.

# Blueprint / pipeline selection (ADR-58). Without this section the engine uses
# the embedded five-stage `standard` pipeline; `blueprint` takes exactly one of
# `name` (a shipped blueprint), `include` (a path), or `inline`. NOTE: an
# active [orchestration] section also makes THIS config own the agent roster —
# with no [multi_agent.custom_agents] entries declared the roster is empty and
# the coordinator self-implements (ADR-35 §8) instead of dispatching to the
# built-in specialists.
[orchestration]
schema_version = 1

[orchestration.blueprint]
name = "standard"                # standard | tdd | docs-only | research-only
#
# For a full inline definition (stages, kinds, flags, per-stage max_cycles,
# fallback personas) see crates/config/src/blueprint.rs and the Orchestration
# Studio. Shipped stage-kind cycle defaults: Review 6, Acceptance 5, all other
# kinds 1.

# Policy rules are first-match-wins. This example allows reads, asks before
# writes/deletes, allows common Cargo verification, then asks for everything
# else. See docs/policy-rules.md before changing these values.
[policy]

[[policy.rules]]
action = "auto_approve"
[policy.rules.condition]
tool_name = "filesystem"
operation = "read"

[[policy.rules]]
action = "require_approval"
[policy.rules.condition]
tool_name = "filesystem"
operation = "write"

[[policy.rules]]
action = "require_approval"
[policy.rules.condition]
tool_name = "filesystem"
operation = "delete"

[[policy.rules]]
action = "auto_approve"
[policy.rules.condition]
command_pattern = "^cargo (check|test|fmt|clippy)( |$)"

[[policy.rules]]
action = "require_approval"
[policy.rules.condition]
always = true

# Optional time window. Hours are 0-23 in the named IANA timezone. Wrapping
# windows such as 22 -> 6 are supported.
# [policy.time_window]
# start_hour = 9
# end_hour = 17
# timezone = "Africa/Johannesburg"
# auto_approve_below_usd = 0.10

# Audit log at-rest protection and retention (ADR-73). Every knob is explicit
# opt-in: the shipped defaults keep the database plaintext and the audit log
# grow-only, exactly as before.
[audit]
encrypt_at_rest = false
#   # When true, `sessions.db` (including `audit_log`) is encrypted with
#   # SQLCipher. The key is generated on first use and stored in the OS keychain
#   # under `audit/db_encryption_key`; CONCERTO_AUDIT_DB_ENCRYPTION_KEY
#   # overrides it and is the supported way to provision a key on a headless
#   # host. The store REFUSES to start if SQLCipher or the key is unavailable —
#   # encryption is never silently downgraded to plaintext.
retention_days = 0              # 0 or omitted = keep every row forever
#   # Days before an `audit_log` row is archived out and deleted. Older rows move
#   # to the archive FIRST; a failed archive write aborts the prune, so a row is
#   # never deleted un-archived. Retention is time-based, not
#   # session-lifecycle-based (ADR-40 vs ADR-73).
# archive_dir = "/path/to/audit-archive"   # omitted = the Concerto data dir

# Tool-level runtime settings applied at session start. The AppConfig field is
# `tool_settings`, so the table is `[tool_settings]` — NOT `[tools]`. A config
# carrying a `[tools]` table is silently ignored (AppConfig has no
# deny_unknown_fields), which is why several source comments that say "[tools]"
# are wrong.
[tool_settings]
git_auto_init = true            # run a bare `git init` when not already in a repo

# Project memory: retrieval, indexing, and persistence. Shared by CLI and
# desktop. Uncommented keys carry their shipped defaults.
[memory]
enabled = true
ttl_days = 30                   # retention window for indexed chunks
# exclude_patterns = ["target/**"]  # default: none (extra project-relative excludes)
# ignore_file = ".concertoignore" # default: none; loaded after .gitignore
summary_keep_per_session = 20   # ADR-65 §8 count cap on derived summaries; 0 = keep all
summary_retention_days = 365    # 0 disables the age-based prune
dedup_judge = true              # ADR-46 L1; advisory and fail-open
# max_out_degree = 32             # ADR-69 out-degree cap; 0 is rejected; default 32
# cascade_decay_days = 90         # ADR-69 decay window; 0 disables decay; >365 rejected

# Frontend motion/accessibility controls shared by desktop and CLI. The default
# is full motion (both cues off-disabled).
[display]
reduced_motion = false
scanline_overlay_enabled = false
animated_terminal_title = true
# theme = "Midnight"             # unset = Midnight; also Slate | Chalk | Nebula;
#                               # --theme / CONCERTO_THEME override
muted_agents = []               # roster ids to grey out in the agent view

# Deterministic context budget for the single-agent loop (ADR-048). The four
# keys below are the engine's embedded defaults; omit any of them to inherit
# the same values from context_compaction.rs.
[context]
trigger_tokens = 16000
retain_user_turns = 4
minimum_user_turns = 6
cache_stable_prefix = false     # true pins a byte-stable cached prompt head

# Shell profiles are normally detected and saved by Settings. The single
# selected profile is used by agents, validation, and the integrated terminal.
# An empty table is the shipped shape: Settings writes the host-detected
# profiles and the selected id into it. A custom profile example:
[shell_settings]
# selected_profile = "my-bash"
#
# [[shell_settings.profiles]]
# id = "my-bash"
# name = "Project Bash"
# backend = "custom"
# executable = "/opt/bin/bash"
# args = []
# login = false
# interactive = true
# encoding = "utf-8"
# default_working_dir = "project_root"

# Exporters are disabled by omitting fields/the entire section. Uncommented
# keys carry their shipped defaults.
[observability]
service_name = "concerto"
# prometheus_port = 9091         # omitted = Prometheus export disabled
# otlp_endpoint = "http://localhost:4318"   # omitted = OTLP disabled
# langfuse_host = "https://cloud.langfuse.com"
# langfuse_public_key = "keyring:langfuse/public_key"
# langfuse_secret_key = "keyring:langfuse/secret_key"

# WASM plugins. Tool, provider, and memory-adapter kinds all execute; a
# memory-adapter plugin supplies an alternative vector store.
[plugins]
enabled = false
# search_paths = ["~/.local/share/concerto/plugins"]  # default: empty = <data-dir>/plugins
# bundled_plugins_enabled = true  # default false
# auto_load = true                # default false; nothing loads while enabled = false

# Skills are local instruction packs injected into prompts (ADR-43). They
# never execute code. `enabled` defaults to false (ADR-43 decision 5 — explicit
# opt-in); set it to true to discover and inject packs. The default search
# paths are <data-dir>/concerto/skills (Linux ~/.local/share, Windows
# %APPDATA%), then ./.concerto/skills; the legacy literal
# ~/.local/share/concerto/skills is kept only when it differs from the
# platform root. `~` and %VAR% references are expanded at discovery time.
[skills]
enabled = false
auto_load = true
# search_paths = ["%APPDATA%\\concerto\\skills", "./.concerto/skills"]  # Windows example
# enabled_ids = ["rust-testing", "commit-style"]  # unset = all discovered when auto_load
# max_chars = 4000  # unset = 4000-char cap on the injected skills section

# MCP client (ADR-43). Default off until you opt in. Servers run as child
# processes; every mcp:* tool is policy-gated (RequireApproval by default).
[mcp]
enabled = false
#
# [[mcp.servers]]
# id = "filesystem"
# command = "npx"
# args = ["-y", "@modelcontextprotocol/server-filesystem", "/safe/path"]
# env = {}
# enabled = true
# timeout_secs = 60  # per-call default, hard cap enforced in the bridge

# Project AGENTS.md injection (ADR-70). Reads the global AGENTS.md at
# <config_dir>/concerto/AGENTS.md plus the project's <root>/AGENTS.md and
# appends both to the system prompt, truncated independently to max_bytes.
# Default off until you opt in (injected into every prompt) — set
# `enabled = true`. Conflicts are resolved project-over-global, with both
# sources named in the prompt. <config_dir> is ~/.config on Linux and
# %APPDATA% on Windows.
[project_context]
enabled = false
# global_path = "~/.config/concerto/AGENTS.md"  # default when unset (per-platform)
# max_bytes = 32768  # 32 KiB per file; per-file truncation with a marker
auto_update_agents_md = false  # coordinator nudge only; never edits files
update_frequency = 1  # nudge every N dispatches when auto_update is on

# The default crates.io update endpoint is not useful for an unpublished
# source build. Disable it unless you provide an endpoint for your deployment.
[updates]
check_on_startup = false
# update_endpoint = "https://example.invalid/concerto/version"
